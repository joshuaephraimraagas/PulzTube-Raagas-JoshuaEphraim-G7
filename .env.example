# PulzTube Environment Variables Configuration
# Copy this file to .env and fill in your values.

# Security
SECRET_KEY=django-insecure-pulztube-dev-key-change-in-production-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL / Supabase)
# For Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Leave empty during initial offline setup to use local development SQLite fallback.
DATABASE_URL=
